# Example file only. Copy this file to .env before filling real keys.
# Do not store production or personal secrets in .env.example because it is tracked by git.

# Active secrets
# Fill only the keys you actually use after copying this file to .env.
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=
ALPHA_VANTAGE_API_KEY=

# LLM runtime
TRADINGAGENTS_LLM_PROVIDER=deepseek
TRADINGAGENTS_DEEP_THINK_LLM=deepseek-v4-pro
TRADINGAGENTS_QUICK_THINK_LLM=deepseek-v4-flash
TRADINGAGENTS_LLM_BACKEND_URL=https://api.deepseek.com
TRADINGAGENTS_OUTPUT_LANGUAGE=English

# Runtime paths
TRADINGAGENTS_RESULTS_DIR=./data/tradingagents/logs
TRADINGAGENTS_CACHE_DIR=./data/tradingagents/cache
TRADINGAGENTS_MEMORY_LOG_PATH=./data/tradingagents/memory/trading_memory.md

# Data vendor routing
#TRADINGAGENTS_CORE_STOCK_VENDOR=yfinance,alpha_vantage
#TRADINGAGENTS_TECHNICAL_INDICATORS_VENDOR=yfinance,alpha_vantage
#TRADINGAGENTS_FUNDAMENTAL_DATA_VENDOR=yfinance,alpha_vantage
#TRADINGAGENTS_NEWS_DATA_VENDOR=yfinance,alpha_vantage

# Tool-level overrides
#TRADINGAGENTS_GET_STOCK_DATA_VENDOR=yfinance,alpha_vantage
#TRADINGAGENTS_GET_NEWS_VENDOR=yfinance,alpha_vantage
#TRADINGAGENTS_GET_GLOBAL_NEWS_VENDOR=yfinance,alpha_vantage
#TRADINGAGENTS_GET_INSIDER_TRANSACTIONS_VENDOR=yfinance,alpha_vantage

# Optional runtime tuning
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_CHECKPOINT_ENABLED=false

# Optional: point at a remote Ollama server instead of the local sidecar.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1